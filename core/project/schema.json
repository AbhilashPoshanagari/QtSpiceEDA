{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtspice.invalid/schema/project-2.json",
  "title": "QtSpice project (.qsp), format version 2 (version 1 files are also valid)",
  "description": "Results are not stored here: each entry of 'results' names an .npz file in the '<project stem>_results' folder next to the .qsp file.",
  "type": "object",
  "required": ["format", "version", "netlists", "diagrams", "block_sources", "analysis", "results"],
  "additionalProperties": false,
  "if": { "properties": { "version": { "const": 1 } } },
  "then": { "not": { "anyOf": [{ "required": ["simulation"] }, { "required": ["schematic"] }, { "required": ["symbols"] }, { "required": ["plots"] }, { "required": ["plot_defs"] }, { "required": ["physical_sources"] }, { "required": ["sweep"] }] } },
  "else": { "required": ["simulation"] },
  "properties": {
    "format": { "const": "qtspice-project" },
    "version": { "enum": [1, 2] },
    "netlists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "text"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "text": { "type": "string" }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "diagram"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "diagram": { "$ref": "#/$defs/diagram" }
        }
      }
    },
    "block_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document", "code"],
        "additionalProperties": false,
        "properties": {
          "document": { "type": "string", "minLength": 1 },
          "code": { "type": "string" }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["card", "diagram_t_end", "diagram_dt"],
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "string",
          "description": "Analysis panel card such as '.tran 1u 1m'; empty means the netlist's own card."
        },
        "diagram_t_end": { "type": "number", "exclusiveMinimum": 0 },
        "diagram_dt": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "simulation": {
      "description": "Format version 2. ngspice settings; version 1 files have none (defaults apply).",
      "type": "object",
      "required": ["compat_mode"],
      "additionalProperties": false,
      "properties": {
        "compat_mode": {
          "type": "string",
          "pattern": "^[a-z]{0,16}$",
          "description": "Sent as 'set ngbehavior=<mode>' before each circuit load; empty = off. Default 'ltpsa'."
        }
      }
    },
    "physical_sources": {
      "description": "Format version 2, optional (M5; part of format version 3 with O1): the code of each user-defined physical component document, like block_sources. Left out when there is none.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document", "code"],
        "additionalProperties": false,
        "properties": {
          "document": { "type": "string", "minLength": 1 },
          "code": { "type": "string" }
        }
      }
    },
    "symbols": {
      "description": "Format version 2, optional: the circuit symbols (.asy, each with a .sub beside it) made for this project. Paths are relative to the .qsp folder (with /) when inside it, else absolute. Left out when there are none.",
      "type": "array",
      "items": { "type": "string", "pattern": "\\.[aA][sS][yY]$" }
    },
    "plots": {
      "description": "Format version 2, optional: the waveform window layout for each analysis type (PlotLayout.to_dict() from core/waveform/layout.py). Ranges are in real units (s, Hz, V, dB, degrees). Left out when there are none.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tran": { "$ref": "#/$defs/plotLayout" },
        "ac": { "$ref": "#/$defs/plotLayout" },
        "dc": { "$ref": "#/$defs/plotLayout" }
      }
    },
    "sweep": {
      "description": "Format version 2, optional (M7; part of format version 3 with O1): the block diagram's parameter sweep, one block parameter and its values as the user typed them (e.g. \"1m 2m 5m\"). Left out when there is none.",
      "type": "object",
      "required": ["block", "parameter", "values"],
      "additionalProperties": false,
      "properties": {
        "block": { "type": "string" },
        "parameter": { "type": "string" },
        "values": { "type": "string" }
      }
    },
    "plot_defs": {
      "description": "Format version 2, optional: the waveform plot definitions text, .func and .param lines in SPICE syntax (core/waveform/plotdefs.py). Left out when it is the shipped default.",
      "type": "string"
    },
    "schematic": {
      "description": "Format version 2, optional: the project's one schematic (Schematic.to_dict() from core/schematic/model.py). Left out when there is none.",
      "$ref": "#/$defs/schematic"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.npz$" }
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": { "type": "boolean" },
        "lo": { "type": "number" },
        "hi": { "type": "number" },
        "log": { "type": "boolean" },
        "abs": { "type": "boolean", "description": "Y only: on a log axis plot |y| instead of hiding values <= 0." }
      }
    },
    "plotLayout": {
      "type": "object",
      "required": ["x", "panes"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/axis" },
        "panes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "traces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "y": { "$ref": "#/$defs/axis" },
              "phase": { "$ref": "#/$defs/axis", "description": "AC only: the phase axis on the right, in degrees." },
              "grid": { "type": "boolean" }
            }
          }
        }
      }
    },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "point": { "type": "integer" },
    "word": { "type": "string", "pattern": "^\\S+$" },
    "schematic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "name", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "x": { "$ref": "#/$defs/point" },
              "y": { "$ref": "#/$defs/point" },
              "rotation": { "enum": [0, 90, 180, 270] },
              "mirror": { "type": "boolean" },
              "attrs": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "type": "array",
            "description": "[x1, y1, x2, y2]",
            "items": { "$ref": "#/$defs/point" },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "name"],
            "additionalProperties": false,
            "properties": {
              "x": { "$ref": "#/$defs/point" },
              "y": { "$ref": "#/$defs/point" },
              "name": { "$ref": "#/$defs/word" }
            }
          }
        },
        "grounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "$ref": "#/$defs/point" }, "y": { "$ref": "#/$defs/point" } }
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "name"],
            "additionalProperties": false,
            "properties": {
              "x": { "$ref": "#/$defs/point" },
              "y": { "$ref": "#/$defs/point" },
              "name": { "$ref": "#/$defs/word" },
              "direction": { "enum": ["in", "out", "bidir"] }
            }
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "text"],
            "additionalProperties": false,
            "properties": {
              "x": { "$ref": "#/$defs/point" },
              "y": { "$ref": "#/$defs/point" },
              "text": { "type": "string" },
              "directive": { "type": "boolean" }
            }
          }
        }
      }
    },
    "diagram": {
      "description": "Diagram.to_dict() from core/blocks/diagram.py.",
      "type": "object",
      "required": ["blocks", "wires"],
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "spec", "x", "y", "settings"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "spec": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "settings": { "type": "object" }
            }
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "dst"],
            "additionalProperties": false,
            "properties": {
              "src": { "type": "string" },
              "dst": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
