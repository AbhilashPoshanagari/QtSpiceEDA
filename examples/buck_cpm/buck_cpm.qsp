 "block_sources": [
  {
   "document": "buck_blocks",
   "code": "# 1 MHz peak current mode synchronous buck, 5 V -> 3.3 V, as blocks.\n# The same converter as this project's schematic: power stage, CPM modulator,\n# dead time and a type II error amplifier. Fixed-step forward Euler, dt = 5 ns.\n#\n# Va = 0 (no slope compensation) as in the original LTspice example: at D = 0.66 peak\n# current mode is subharmonically unstable, so the inductor current ripple alternates\n# from cycle to cycle and the start-up transient is long. Set CPM's Va to 0.3 to see\n# the ripple settle to the ideal +-0.56 A.\n\n\n@block\ndef LoadPulse(t, i1=2.0, delay=110e-6, rise=1e-6, width=30e-6, fall=1e-6):\n    \"\"\"Load current step, like the schematic's Iload PULSE(0 2 110u 1u 1u 30u).\"\"\"\n    s = t - delay\n    if s < 0:\n        return 0.0\n    if s < rise:\n        return i1 * s / rise\n    if s < rise + width:\n        return i1\n    if s < rise + width + fall:\n        return i1 * (1 - (s - rise - width) / fall)\n    return 0.0\n\n\n@block(stateful=True, outputs=[\"vout\", \"iL\", \"vsw\"], color=\"#c0504d\")\nclass BuckPowerStage:\n    \"\"\"Synchronous buck power stage. c1 drives the high-side switch, c2 the low-side one\n    (0 or 1, after a gate-driver delay). With both off, the body diodes carry iL.\"\"\"\n\n    def __init__(self, vin=5.0, L=1e-6, RL=15e-3, C=200e-6, Resr=0.8e-3, Rload=1000.0,\n                 Ron=13e-3, Vd=0.7, delay=20e-9, vc0=3.3, iL0=0.0):\n        self.vin, self.L, self.RL, self.C = vin, L, RL, C\n        self.Resr, self.Rload, self.Ron, self.Vd = Resr, Rload, Ron, Vd\n        self.vc, self.iL = vc0, iL0\n        self.delay = delay\n        self.queue = None  # gate-driver delay line, sized on the first step\n        self.vsw = 0.0\n        self.iload = 0.0\n\n    def _vout(self, iload):\n        # node: (vout - vc)/Resr + vout/Rload = iL - iload\n        g = 1 / self.Resr + 1 / self.Rload\n        return (self.vc / self.Resr + self.iL - iload) / g\n\n    def output(self):\n        return self._vout(self.iload), self.iL, self.vsw\n\n    def step(self, c1, c2, iload, dt):\n        if self.queue is None:\n            self.queue = [(0.0, 0.0)] * max(0, round(self.delay / dt))\n        self.queue.append((c1, c2))\n        c1, c2 = self.queue.pop(0)\n        if c1 > 0.5:\n            vsw = self.vin - self.iL * self.Ron\n        elif c2 > 0.5:\n            vsw = -self.iL * self.Ron\n        elif self.iL > 0:\n            vsw = -self.Vd  # low-side body diode\n        else:\n            vsw = self.vin + self.Vd  # high-side body diode\n        vout = self._vout(iload)\n        self.vsw, self.iload = vsw, iload\n        self.iL += (vsw - self.iL * self.RL - vout) / self.L * dt\n        self.vc += (vout - self.vc) / self.Resr / self.C * dt\n\n\n@block(stateful=True, color=\"#4f81bd\")\nclass CPMModulator:\n    \"\"\"Peak current mode modulator. A clock sets the latch at the start of each period;\n    it resets when vs + Voffset + ramp reaches vc (limited to 0 .. Vcmax + Voffset), or at\n    Dmax. Output 1 = switch on. Reset wins over set, as in the schematic's latch.\"\"\"\n\n    def __init__(self, fs=1e6, Va=0.0, Vcmax=0.8, Dmin=0.0, Dmax=0.95, Voffset=1.0):\n        self.T, self.Va, self.Vcmax = 1 / fs, Va, Vcmax\n        self.Dmin, self.Dmax, self.Voffset = Dmin, Dmax, Voffset\n        self.phase = 0.0\n        self.q = 0.0\n\n    def output(self):\n        return self.q\n\n    def step(self, vc, vs, dt):\n        b = min(max(vc, 0.0), self.Vcmax + self.Voffset)\n        a = vs + self.Voffset + self.Va * self.phase / self.T\n        reset = a > b or self.phase >= self.Dmax * self.T\n        if self.phase < dt / 2:  # clock edge: set\n            self.q = 1.0\n        if reset and self.phase >= self.Dmin * self.T:\n            self.q = 0.0\n        self.phase += dt\n        if self.phase >= self.T - dt / 2:\n            self.phase = 0.0\n\n\n@block(stateful=True, outputs=[\"c1\", \"c2\"], color=\"#4f81bd\")\nclass DeadTime:\n    \"\"\"c1 = pwm and c2 = not pwm, each with its rising edge delayed by Td.\"\"\"\n\n    def __init__(self, Td=30e-9):\n        self.Td = Td\n        self.high_for = 0.0  # how long pwm has been 1\n        self.low_for = 0.0\n        self.c1 = self.c2 = 0.0\n\n    def output(self):\n        return self.c1, self.c2\n\n    def step(self, pwm, dt):\n        if pwm > 0.5:\n            self.high_for += dt\n            self.low_for = 0.0\n        else:\n            self.low_for += dt\n            self.high_for = 0.0\n        self.c1 = 1.0 if self.high_for > self.Td else 0.0\n        self.c2 = 1.0 if self.low_for > self.Td else 0.0\n\n\n@block(stateful=True, color=\"#9bbb59\")\nclass TypeIICompensator:\n    \"\"\"Ideal inverting op-amp with R1 from vout to the inverting input and\n    C3 || (R2 + C2) from there to the output; the + input is vref.\n    Output limited to the 0 .. 5 V supply.\"\"\"\n\n    def __init__(self, R1=1.2e3, R2=15e3, C2=220e-12, C3=10e-12, vmin=0.0, vmax=5.0):\n        self.R1, self.R2, self.C2, self.C3 = R1, R2, C2, C3\n        self.vmin, self.vmax = vmin, vmax\n        self.v3 = 0.0  # across C3 (= R2 + C2 branch), inverting input minus output\n        self.v2 = 0.0  # across C2\n        self.y = 0.0\n\n    def output(self):\n        return self.y\n\n    def step(self, vout, vref, dt):\n        # In the linear range the inverting input sits at vref. With the output at a\n        # rail it no longer does: it is the output plus the voltage across C3.\n        self.y = min(max(vref - self.v3, self.vmin), self.vmax)\n        vfb = self.y + self.v3\n        i1 = (vout - vfb) / self.R1\n        i2 = (self.v3 - self.v2) / self.R2\n        self.v3 += (i1 - i2) / self.C3 * dt\n        self.v2 += i2 / self.C2 * dt\n"
  }
 ],
